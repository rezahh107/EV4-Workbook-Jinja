{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:elementor-workbook:schema:course:1.0.0",
  "title": "Elementor workbook build manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator_version",
    "workbook_version",
    "content_baseline",
    "html_title",
    "lang",
    "direction",
    "default_theme",
    "template",
    "output",
    "static_directories",
    "units"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "generator_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "workbook_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "content_baseline": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "html_title": {"type": "string", "minLength": 1},
    "lang": {"type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"},
    "direction": {"type": "string", "enum": ["rtl", "ltr", "auto"]},
    "default_theme": {"type": "string", "minLength": 1},
    "template": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+\\.j2$"},
    "output": {"type": "string", "pattern": "^course/[A-Za-z0-9._-]+\\.html$"},
    "static_directories": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
      "uniqueItems": true
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "urn:elementor-workbook:schema:unit:1.0.0"}
    }
  }
}
