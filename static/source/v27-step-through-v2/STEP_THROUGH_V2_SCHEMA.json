{
  "$id": "https://example.invalid/elementor-workbook/step-through-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "goal": {
      "type": "string"
    },
    "id": {
      "pattern": "^stv2-[a-z0-9-]+$",
      "type": "string"
    },
    "lab_target": {
      "type": "string"
    },
    "lesson_id": {
      "type": "string"
    },
    "renderer": {
      "enum": [
        "width-overflow",
        "flex-axis",
        "responsive-inheritance",
        "class-priority"
      ]
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "states": {
      "maxItems": 7,
      "minItems": 4,
      "type": "array"
    },
    "storage_key": {
      "type": "string"
    },
    "title": {
      "minLength": 3,
      "type": "string"
    },
    "type": {
      "enum": [
        "cause_effect_debug",
        "state_change",
        "layer_reveal_debug",
        "decision_propagation"
      ]
    },
    "verification": {
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "lesson_id",
    "type",
    "renderer",
    "storage_key",
    "goal",
    "verification",
    "states"
  ],
  "title": "Elementor Workbook Step-Through v2",
  "type": "object"
}